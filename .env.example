# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
HUBSPOT_PRIVATE_APP_TOKEN=
# replay (default, no key needed) or claude
GROUNDWORK_MODEL=replay
# replay (default, only recorded queries) or voyage (any query, needs VOYAGE_API_KEY)
GROUNDWORK_EMBEDDING=replay
# Voyage calls a minute, to stay under the reduced limit of an account with no payment method (3)
# VOYAGE_RPM=3
# client pack served by the mcp service of docker-compose
GROUNDWORK_PACK=acme
